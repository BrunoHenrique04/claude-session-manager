#!/usr/bin/env bash
# Launcher used by the .desktop entry: runs the app from its source tree
# regardless of the current working directory.
set -euo pipefail
APP_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
export PYTHONPATH="${APP_DIR}${PYTHONPATH:+:${PYTHONPATH}}"
exec python3 -m claude_session_manager "$@"
